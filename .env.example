# Copy this file to `.env` (which is gitignored) and fill in real values.
# data_ingest.py loads it via python-dotenv so the key never touches source code.

# USDA NASS Quick Stats API key (request your own at https://quickstats.nass.usda.gov/api).
NASS_API_KEY=PUT-YOUR-KEY-HERE

# Google Earth Engine cloud project id (for the MODIS NDVI loader). Register a free
# noncommercial project at https://code.earthengine.google.com, then run
# `python scripts/ee_authenticate.py` once. This id is user-specific, not a secret.
EE_PROJECT=your-ee-project-id
