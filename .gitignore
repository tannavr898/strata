# Secrets — the NASS key (and any future keys) live here, never in git.
.env

# Pulled datasets. Raw source data is reproduced from provenance in the README,
# not committed. Keep the repo light and avoid redistributing source data.
data/raw/
data/processed/
data/interim/

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Notebooks / tooling
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Model artifacts. Reproducible with `python scripts/build_models.py`; large
# binaries that would bloat history, so they are built, not committed.
data/models/

# App database (a running instance's own data, not source).
data/strata.db

# Documentation hooks: per-turn scratch state (see .claude/hooks/).
.claude/last_prompt.txt
.claude/hooks/.turn_state.json
.claude/hooks/__pycache__/
